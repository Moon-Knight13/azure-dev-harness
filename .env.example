# Azure Dev Harness — Environment Variables
# Copy to .env and fill in values. Never commit .env itself.

# ── Azure environment ─────────────────────────────────────────────────────────
AZURE_ENV_NAME=dev
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus

# Resource names (populated by azd or bootstrap)
AZURE_ACR_NAME=
AZURE_KEYVAULT_NAME=
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=appdb
AZURE_APP_SERVICE_NAME=

# ── Feature toggles ──────────────────────────────────────────────────────────
CAVEMAN_ENABLED=1
CAVEMAN_MODE=lite
BMAD_ENABLED=1
LOCAL_MODEL_ENABLED=false

# ── GitHub auth ───────────────────────────────────────────────────────────────
# Do NOT put a GitHub token here (or in any env var / repo file). Authenticate
# in the container terminal with browser OAuth instead:
#   gh auth login --hostname github.com --git-protocol https --web
# The token lands in gh's config (a named volume outside the workspace), git
# uses it via gh's credential helper, and nothing is readable from the repo.

# ── Azure auth ────────────────────────────────────────────────────────────────
# Do NOT put Azure credentials here. Use:
#   az login        (interactive)
#   azd auth login  (for azd CLI)
# On Azure VM, managed identity handles auth automatically via
# DefaultAzureCredential. No client secrets or connection strings needed.
